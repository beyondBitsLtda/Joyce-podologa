# =============================================================================
# Copie para .env e preencha. O .env NÃO vai para o git.
# Apenas variáveis com prefixo VITE_ chegam ao navegador.
# =============================================================================

# Supabase — Project Settings > API
VITE_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"

# Chave PUBLISHABLE / anon. É pública por natureza: quem protege os dados é o
# RLS do Postgres, não o segredo da chave.
# NUNCA use aqui a service_role key — ela ignora RLS e daria acesso total
# ao prontuário de todos os pacientes a qualquer visitante do site.
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Identidade da clínica exibida na interface
VITE_CLINIC_NAME="Joyce Freitas Podologia"

# Ambiente local do Supabase CLI (npm run db:start) usa:
# VITE_SUPABASE_URL="http://127.0.0.1:54321"
# VITE_SUPABASE_ANON_KEY= (o CLI imprime a chave ao subir)
