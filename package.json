{
  "name": "passo-leve",
  "version": "0.1.0",
  "private": true,
  "description": "Prontuário digital de podologia — anamnese, agenda e evolução clínica.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,css}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/data/database.types.d.ts",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "supabase": "^1.192.5",
    "vite": "^5.4.0",
    "wrangler": "^3.72.0"
  }
}
